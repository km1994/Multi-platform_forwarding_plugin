{
  "manifest_version": 3,
  "name": "多平台转发助手 · MultiPost Sync",
  "version": "0.4.9",
  "description": "一键将同一篇文章同步到知乎、掘金、CSDN、公众号、头条、简书、博客园、B站、百家号、51CTO、开源中国、腾讯云/阿里云社区等编辑器；小红书/微博/X/抖音等走复制粘贴模式；支持多主题排版、图床、预览与诊断日志。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "tabs", "scripting", "alarms", "declarativeNetRequest", "clipboardRead", "clipboardWrite"],
  "host_permissions": [
    "https://sm.ms/*",
    "https://catbox.moe/*",
    "https://freeimage.host/*",
    "https://api.imgbb.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://juejin.cn/*",
    "https://editor.csdn.net/*",
    "https://mp.weixin.qq.com/*",
    "https://mp.toutiao.com/*",
    "https://www.jianshu.com/*",
    "https://i.cnblogs.com/*",
    "https://member.bilibili.com/*",
    "https://baijiahao.baidu.com/*",
    "https://blog.51cto.com/*",
    "https://my.oschina.net/*",
    "https://cloud.tencent.com/*",
    "https://developer.aliyun.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://zhuanlan.zhihu.com/*",
        "https://juejin.cn/*",
        "https://editor.csdn.net/*",
        "https://mp.weixin.qq.com/*",
        "https://mp.toutiao.com/*",
        "https://www.jianshu.com/*",
        "https://i.cnblogs.com/*",
        "https://member.bilibili.com/*",
        "https://baijiahao.baidu.com/*",
        "https://blog.51cto.com/*",
        "https://my.oschina.net/*",
        "https://cloud.tencent.com/*",
        "https://developer.aliyun.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "lib/marked.min.js",
        "common/platforms.js",
        "common/themes.js",
        "common/formulas.js",
        "content/inject-common.js",
        "content/adapters/index.js",
        "content/main.js"
      ],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
